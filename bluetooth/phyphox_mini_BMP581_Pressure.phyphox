<phyphox version="1.20" locale="en">
    <title>Pressure, Temperature</title>
    <category>phyphox:mini raw sensor</category>
	<color>ADEBB3</color>
	<icon format="base64"></icon>
    <description>Using the Bosch BMP581 sensor to measure air pressure and temperature.</description>
	<translations>
    <translation locale="de">
      <title>Luftdruck, Temperatur</title>
      <category>phyphox:mini Sensoren</category>
      <description>Verwendung des Bosch BMP581 Sensors zur Messung von Luftdruck und Temperatur.</description>
      <string original="Rawdata">Rohdaten</string>
      <string original="Pressure">Luftdruck</string>
	  <string original="Temperature">Temperatur</string>
	  <string original="Altitude (calculated)">Höhe (berechnet)</string>
	  <string original="Altitude">Höhe</string>
	  <string original="Settings">Einstellungen</string>
	  <string original="iir coefficient">IIR-Koeffizient</string>
	  <string original="set configuration">Konfiguration übernehmen</string>
	</translation>
	</translations>
    <data-containers>
		<container size="0">time_raw</container>	
		<container size="0">time</container>
		
		<container size="0">pressure_raw</container>		
		<container size="0">pressure</container>
		
		<container size="0">height</container>
		<container size="0">temperature_raw</container>
		<container size="0">temperature</container>
		
		<container size="0">reference_values</container>
		<container size="1">reference_average</container>
			
		<container size="1" static="false" init="1" clearGroup="_">cfg_enable</container>
		<container size="1" static="false" init="4" clearGroup="_">cfg_oversampling</container>
		<container size="1" static="false" init="1" clearGroup="_">cfg_iir</container>
				
    </data-containers>
    <input>
        <bluetooth id="phyphox:mini" name="phyphox:mini" mode="notification" mtu="180" subscribeOnStart="true">
			<config char="cddf1008-30f7-4671-8b43-5e40ba53514a" conversion="hexadecimal">010401</config>
			<output char="cddf1007-30f7-4671-8b43-5e40ba53514a" offset="0" conversion="float32LittleEndian" repeating="12">pressure_raw</output>
			<output char="cddf1007-30f7-4671-8b43-5e40ba53514a" offset="4" conversion="float32LittleEndian" repeating="12">temperature_raw</output>
			<output char="cddf1007-30f7-4671-8b43-5e40ba53514a" offset="8" conversion="float32LittleEndian" repeating="12">time_raw</output>
        </bluetooth>
    </input>
	<output>
	<bluetooth id="phyphox:mini" name="phyphox:mini">
		<input keep="true" char="cddf1008-30f7-4671-8b43-5e40ba53514a" conversion="singleByte" offset="0" triggerId="setConfig">cfg_enable</input>
		<input keep="true" char="cddf1008-30f7-4671-8b43-5e40ba53514a" conversion="singleByte" offset="1" triggerId="setConfig">cfg_oversampling</input>
		<input keep="true" char="cddf1008-30f7-4671-8b43-5e40ba53514a" conversion="singleByte" offset="2" triggerId="setConfig">cfg_iir</input>
	</bluetooth>
	</output>
	<views>
        <view label="Rawdata">
            <graph label="Pressure" timeOnX="true" labelX="t" unitX="s" labelY="p" unitY="hPa" partialUpdate="true">
                <input axis="y">pressure</input>
                <input axis="x">time</input>
            </graph>
            <value label="Pressure" size="1" precision="3" scientific="false" unit="hPa" factor="1" >
                <input>pressure</input>
            </value>
            
            <graph label="Temperature" timeOnX="true" labelX="t" unitX="s" labelY="T" unitY="°C" partialUpdate="true">
                <input axis="y">temperature</input>
                <input axis="x">time</input>
            </graph>
            <value label="Temperature" size="1" precision="1" scientific="false" unit="°C" factor="1" >
                <input>temperature</input>
            </value>
            <graph label="Altitude (calculated)" timeOnX="true" labelX="t" labelY="h" unitX="s" unitY="m" partialUpdate="true">
                <input axis="x">time</input>
                <input axis="y">height</input>
            </graph>
            <value label="Altitude" size="1" precision="1" scientific="false" unit="m" factor="1" >
                <input>height</input>
            </value>		
        </view>		
        <view label="Settings">		
			<dropdown label="iir coefficient" default="1">
				<output>cfg_iir</output>
				<map value="1">1</map>
				<map value="2">3</map>
				<map value="3">7</map>
				<map value="4">15</map>
				<map value="5">31</map>
				<map value="6">63</map>
				<map value="7">127</map>
			</dropdown>			
			<dropdown label="Oversampling" default="4">
				<output>cfg_oversampling</output>
				<map value="0">1x</map>
				<map value="1">2x</map>
				<map value="2">4x</map>
				<map value="3">8x</map>
				<map value="4">16x</map>
				<map value="5">32x</map>
				<map value="6">64x</map>
				<map value="7">128x</map>
			</dropdown>
			<button label="set configuration">
				<trigger>setConfig</trigger>
			</button>			
        </view>	
    </views>
	<analysis requireFill="pressure_raw">
		<subrange cycles="1-20">
            <input as="in" clear="false">pressure_raw</input>
            <input as="from" type="value">0</input>
            <input as="length" type="value">50</input>
            <output as="out" clear="true">reference_values</output>
        </subrange>
        <average cycles="1-20">
            <input as="buffer" clear="false">reference_values</input>
            <output as="average" >reference_average</output>
        </average>
        <formula formula="44330*(1-([1_]/[2])^(1/5.255))">
            <input as="in" clear="false">pressure_raw</input>
            <input as="in" clear="false">reference_average</input>
            <output clear="false" as="out">height</output>
        </formula>					
		<append>
            <input as="in" clear="true">pressure_raw</input>
            <output as="out" clear="false" >pressure</output>
        </append>	
		<append>
            <input as="in" clear="true">time_raw</input>
            <output as="out" clear="false" >time</output>
        </append>		
		<append>
            <input as="in" clear="true">temperature_raw</input>
            <output as="out" clear="false" >temperature</output>
        </append>		
    </analysis>
    <export>
        <set name="Raw Data">
            <data name="Time (s)">time</data>
			<data name="Pressure (hPa)">pressure</data>
			<data name="Temperature (°C)">temperature</data>
			<data name="Altitude (m)">height</data>
        </set>
    </export>
</phyphox>