    <translation locale="bn"/>
    <translation locale="gu">
      <string original="Frequency">ફ્રીક્વન્સી</string>
      <string original="Period">પિરીઅડ</string>
      <string original="Preview">પૂર્વાવલોકન</string>
      <title>ફ્લેશલાઇટ સ્ટ્રોબોસ્કોપ</title>
      <category>ટૂલ્સ</category>
      <description>તમારા ફોનની ફ્લેશલાઇટને ટ્યુનેબલ ફ્રીક્વન્સી સાથે ટૉગલ કરો. નોંધ કરો કે ફ્લેશ ચોક્કસ સમય સાથે ટૉગલ કરવા માટે ડિઝાઇન કરવામાં આવી નથી. તમારા ફોનના મોડેલના આધારે, ઉપયોગી ફ્રીક્વન્સી મર્યાદિત હોઈ શકે છે. કૃપા કરીને સ્ટ્રોબ કંટ્રોલ્સ હેઠળ બતાવેલ માહિતી પર ધ્યાન આપો.</description>
      <string original="Strobe">સ્ટ્રોબ</string>
      <string original="Brightness">બ્રાઇટનેસ</string>
      <string original="Duty cycle">ડયુટી સાઇકલ</string>
      <string original="Reset duty cycle to 0.5">ડ્યુટી સાઇકલને 0.5 પર રીસેટ કરો</string>
      <string original="On duration">ચાલુ સમયગાળો</string>
      <string original="Off duration">બંધ સમયગાળો</string>
      <string original="The maximum possible rate varies across phone models and cannot be verified by phyphox. Slowly increase the stroboscope frequency and keep an eye on the emitted light. If you notice irregular flickering or a sudden change in brightness, you should assume that you have reached the maximum frequency and that higher flash rates will not be reproduced correctly by your phone.">મહત્તમ શક્ય દર ફોન મોડેલોમાં બદલાય છે અને phyphox દ્વારા તેની ચકાસણી કરી શકાતી નથી. ધીમે ધીમે સ્ટ્રોબોસ્કોપ ફ્રીક્વન્સી વધારો અને ઉત્સર્જિત પ્રકાશ પર નજર રાખો. જો તમને અનિયમિત ઝબકવું અથવા બ્રાઇટનેસમાં અચાનક ફેરફાર દેખાય, તો તમારે માની લેવું જોઈએ કે તમે મહત્તમ ફ્રીક્વન્સી પર પહોંચી ગયા છો અને તમારા ફોન દ્વારા ઉચ્ચ ફ્લેશ દર યોગ્ય રીતે પુનઃઉત્પાદિત થશે નહીં.</string>
      <string original="The highest frequency can be achieved with a duty cycle of 0.5 to space the switching events evenly. The on and off durations will be highlighted in red below typical limits, but your phone may have lower or higher limits.">સ્વિચિંગ ઇવેન્ટ્સને સમાન રીતે અંતર આપવા માટે 0.5 ના ડ્યુટી સાઇકલ સાથે સૌથી વધુ ફ્રીક્વન્સી પ્રાપ્ત કરી શકાય છે. ચાલુ અને બંધ સમયગાળો લાક્ષણિક મર્યાદાઓથી નીચે લાલ રંગમાં પ્રકાશિત થશે, પરંતુ તમારા ફોનમાં ઓછી અથવા ઊંચી મર્યાદા હોઈ શકે છે.</string>
    </translation>
    <translation locale="kn"/>
    <translation locale="or"/>
    <translation locale="ko">
      <title>손전등 스트로보스코프</title>
      <category>도구</category>
      <description>조절 가능한 진동수로 휴대폰 손전등을 점멸합니다. 손전등은 정밀한 타이밍으로 점멸하도록 설계되지 않았다는 점에 유의하세요. 휴대폰 모델에 따라 사용할 수 있는 진동수가 제한될 수 있습니다. 스트로보 제어기 하단에 표시되는 정보를 확인하세요.</description>
      <string original="Strobe">스트로보</string>
      <string original="Brightness">밝기</string>
      <string original="Frequency">진동수</string>
      <string original="Duty cycle">듀티 사이클</string>
      <string original="Reset duty cycle to 0.5">듀티 사이클을 0.5로 초기화</string>
      <string original="Period">주기</string>
      <string original="On duration">켜짐 시간</string>
      <string original="Off duration">꺼짐 시간</string>
      <string original="Preview">미리보기</string>
      <string original="The maximum possible rate varies across phone models and cannot be verified by phyphox. Slowly increase the stroboscope frequency and keep an eye on the emitted light. If you notice irregular flickering or a sudden change in brightness, you should assume that you have reached the maximum frequency and that higher flash rates will not be reproduced correctly by your phone.">최대 가능 진동수는 휴대폰 모델에 따라 다르며 phyphox에서 검증할 수 없습니다. 스트로보스코프 진동수를 천천히 올리면서 나오는 빛을 주시하세요. 불규칙한 깜빡임이나 갑작스러운 밝기 변화가 느껴진다면 최대 진동수에 도달한 것이며, 그보다 높은 점멸 속도는 휴대폰에서 올바르게 구현되지 않는 것으로 간주해야 합니다.</string>
      <string original="The highest frequency can be achieved with a duty cycle of 0.5 to space the switching events evenly. The on and off durations will be highlighted in red below typical limits, but your phone may have lower or higher limits.">스위칭 간격을 균일하게 유지하기 위해 듀티 사이클을 0.5로 설정할 때 가장 높은 진동수를 얻을 수 있습니다. 켜짐 및 꺼짐 시간이 일반적인 제한 수준 아래로 떨어지면 빨간색으로 강조 표시되지만, 사용 중인 휴대폰의 실제 제한 수준은 이보다 낮거나 높을 수 있습니다.</string>
    </translation>
  </translations>
  <data-containers>
    <container size="1" init="1">intensity</container>
    <container size="1" init="5">frequency</container>
    <container size="1" init="0.5">dutycycle</container>
    <container size="1">period</container>
    <container size="1">period3</container>
    <container size="1">on</container>
    <container size="1">off</container>
    <container size="1">onok</container>
    <container size="1">offok</container>
    <container size="1">onwarning</container>
    <container size="1">offwarning</container>
    <container size="0">previewt</container>
    <container size="0">previewy</container>
  </data-containers>
  <output>
    <flashlight>
      <input parameter="intensity">intensity</input>
      <input parameter="frequency">frequency</input>
      <input parameter="dutycycle">dutycycle</input>
    </flashlight>
  </output>
  <views>
    <view label="Strobe">
      <slider label="Brightness" minValue="0" maxValue="1" stepSize="0.01">
        <output>intensity</output>
      </slider>
      <edit label="Frequency" min="0" max="50" unit="[[unit_short_hertz]]">
        <output>frequency</output>
      </edit>
      <slider label="Frequency" minValue="0" maxValue="50" stepSize="0.1" showValue="false">
        <output>frequency</output>
      </slider>
      <slider label="Duty cycle" minValue="0.01" maxValue="0.99" stepSize="0.01">
        <output>dutycycle</output>
      </slider>
      <button label="Reset duty cycle to 0.5">
        <input type="value">0.5</input>
        <output>dutycycle</output>
      </button>
      <value label="Period" unit="[[unit_short_milli_second]]" factor="1000">
        <input>period</input>
      </value>
      <value label="On duration" visibility="onok" unit="[[unit_short_milli_second]]" factor="1000">
        <input>on</input>
      </value>
      <value label="On duration" visibility="onwarning" unit="[[unit_short_milli_second]]" color="red" factor="1000">
        <input>on</input>
      </value>
      <value label="Off duration" visibility="offok" unit="[[unit_short_milli_second]]" factor="1000">
        <input>off</input>
      </value>
      <value label="Off duration" visibility="offwarning" unit="[[unit_short_milli_second]]" color="red" factor="1000">
        <input>off</input>
      </value>
      <graph label="Preview" scaleMinX="fixed" scaleMinY="fixed" scaleMaxY="fixed" minX="0" minY="0" maxY="1" unitX="[[unit_short_second]]" labelX="[[quantity_short_time]]" labelY="Brightness">
        <input axis="x">previewt</input>
        <input axis="y">previewy</input>
      </graph>
      <info label="The maximum possible rate varies across phone models and cannot be verified by phyphox. Slowly increase the stroboscope frequency and keep an eye on the emitted light. If you notice irregular flickering or a sudden change in brightness, you should assume that you have reached the maximum frequency and that higher flash rates will not be reproduced correctly by your phone."/>
      <info label="The highest frequency can be achieved with a duty cycle of 0.5 to space the switching events evenly. The on and off durations will be highlighted in red below typical limits, but your phone may have lower or higher limits."/>
    </view>
  </views>
  <analysis onUserInput="true">
    <divide>
      <input type="value">1</input>
      <input keep="true">frequency</input>
      <output>period</output>
    </divide>
    <multiply>
      <input keep="true">period</input>
      <input type="value">3</input>
      <output>period3</output>
    </multiply>
    <multiply>
      <input keep="true">dutycycle</input>
      <input keep="true">period</input>
      <output>on</output>
    </multiply>
    <subtract>
      <input keep="true">period</input>
      <input keep="true">on</input>
      <output>off</output>
    </subtract>
    <if less="true">
      <input keep="true">on</input>
      <input type="value">0.025</input>
      <input type="value">1</input>
      <input type="value">0</input>
      <output>onwarning</output>
    </if>
    <subtract>
      <input type="value">1</input>
      <input keep="true">onwarning</input>
      <output>onok</output>
    </subtract>
    <if less="true">
      <input keep="true">off</input>
      <input type="value">0.025</input>
      <input type="value">1</input>
      <input type="value">0</input>
      <output>offwarning</output>
    </if>
    <subtract>
      <input type="value">1</input>
      <input keep="true">offwarning</input>
      <output>offok</output>
    </subtract>
    <ramp>
      <input as="start" type="value">0</input>
      <input as="length" type="value">301</input>
      <input as="stop" keep="true">period3</input>
      <output>previewt</output>
    </ramp>
    <formula formula="[4]*heaviside([3]-[1_]%[2])">
      <input keep="true">previewt</input>
      <input keep="true">period</input>
      <input keep="true">on</input>
      <input keep="true">intensity</input>
      <output>previewy</output>
    </formula>
  </analysis>
</phyphox>
